HABLAPE_ENV=local
HABLAPE_MODEL_PROVIDER=rules
HABLAPE_TRACE_PROVIDER=memory
HABLAPE_CORS_ORIGINS=http://localhost:3000
HABLAPE_MAX_TEXT_CHARS=4000

# Se completan al conectar GCP. No guardar llaves JSON en este archivo.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
HABLAPE_VERTEX_ENDPOINT=
HABLAPE_FIRESTORE_DATABASE=(default)

