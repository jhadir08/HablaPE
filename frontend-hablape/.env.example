# Same-origin BFF configuration. In local development use the FastAPI URL.
HABLAPE_BACKEND_URL=http://127.0.0.1:8000
HABLAPE_BACKEND_AUTH=none

# In Cloud Run set id-token and use the backend service URL as audience.
HABLAPE_BACKEND_AUDIENCE=

# Optional: only used by the legacy TTS/demo routes, not by /api/query.
GEMINI_API_KEY=
HABLAPE_ENABLE_LEGACY_AI=false
